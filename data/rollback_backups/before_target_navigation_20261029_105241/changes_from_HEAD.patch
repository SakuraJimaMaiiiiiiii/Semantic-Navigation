-    def _build_global_grid(
-        self,
-        indices,
-        values,
-        resolution,
-        occupied_threshold,
-        free_threshold,
-        support_points,
-    ) -> tuple[np.ndarray, float, np.ndarray]:
-        """将稀疏三维体素投影成连续的二维鸟瞰占据栅格。"""
